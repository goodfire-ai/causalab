__pycache__
*.pyc
*.pyo
*.egg-info/
/dist/
/build/
.config
.zed
.vscode
*.lock
# uv.lock pins the environment `uv sync` builds, so it is tracked.
!uv.lock

# Testing and coverage artifacts
.coverage
.coverage.*
coverage.xml
htmlcov/
pytest.xml
.pytest_cache/

/artifacts*
/content/
/results/
/logs/
/output/
/multirun/
*.log
/figures/
/slurm_logs/

/.venv/

# NFS temp files
.nfs*

/demos/onboarding_tutorial/*result*/
/demos/onboarding_tutorial/*logs/
/demos/onboarding_tutorial/*dataset*/
/demos/onboarding_tutorial/*temp*/

/causalab/tasks/**/*results
/causalab/tasks/**/*datasets
/causalab/tasks/**/*logs
/causalab/tasks/**/outputs/

agent_logs/

.vscode/settings.json
.env

# Any worktree checkout parked inside the repo — `.worktrees/`, `worktrees/`,
# `.claude/worktrees/`, `<name>-worktree/` — is a sibling clone, never content.
*worktree*/

# Generated files
/figures/*.pdf
**/output/*.html
**/output/*.png
test_run_logs/

# Archived workflow attempts; keep only the current run outputs in Git.
.attempts/

# `uv build` output — the standalone-install recipe builds a wheel locally
# (docs/standalone_install.md); it is never committed.
dist/

# The Rust core of causalab/io/fastersafetensors (crates/): build output and
# the extension maturin drops into the source tree on an editable install.
/target/
*.so
# `*.lock` above would swallow the Cargo lockfile, which is committed
!/Cargo.lock
