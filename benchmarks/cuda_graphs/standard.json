{
  "version": "1",
  "description": "bench: a realistic multi-technique study on Qwen3.6-35B-A3B over one task table. Interchange scan over 10 layers, DAS fits at 3 layers x 2 ranks, DBM fits at 3 layers, the matched-k random-subspace control at the same cells, and a mean-replacement harvest/ablation pair. Every step names the same model realization (bf16) and the same dataset, so the un-intervened forwards are shared work.",
  "output_dir": "bench_a3b",
  "steps": {
    "locate": {
      "type": "intervention_protocol",
      "document": "../../demos/methods/protocols/weekdays_locate_scan.json",
      "set": {
        "model.key": "Qwen/Qwen3.6-35B-A3B",
        "model.dtype": "bf16",
        "data.base.dataset": "months/data#train",
        "data.counterfactual.dataset": "months/data#train",
        "sites.target.layers": {
          "sweep": {
            "range": [
              0,
              40,
              4
            ]
          }
        },
        "positions.tap": {
          "sweep": [
            {
              "index": -1
            }
          ]
        }
      }
    },
    "das": {
      "type": "intervention_protocol",
      "document": "../../demos/methods/protocols/das.json",
      "set": {
        "model.key": "Qwen/Qwen3.6-35B-A3B",
        "data.base.dataset": "months/data#train",
        "data.counterfactual.dataset": "months/data#train",
        "train.eval.split": "months/data#test",
        "sites.target.layers": {
          "sweep": [
            12,
            20,
            28
          ]
        },
        "featurizers.rot.k": {
          "sweep": [
            8,
            32
          ]
        }
      }
    },
    "dbm": {
      "type": "intervention_protocol",
      "document": "../../demos/methods/protocols/dbm.json",
      "set": {
        "model.key": "Qwen/Qwen3.6-35B-A3B",
        "data.base.dataset": "months/data#train",
        "data.counterfactual.dataset": "months/data#train",
        "train.eval.split": "months/data#test",
        "sites.target.layers": {
          "sweep": [
            12,
            20,
            28
          ]
        }
      }
    },
    "control": {
      "type": "intervention_protocol",
      "document": "../../demos/methods/protocols/random_subspace_control.json",
      "set": {
        "model.key": "Qwen/Qwen3.6-35B-A3B",
        "model.dtype": "bf16",
        "data.base.dataset": "months/data#test",
        "data.counterfactual.dataset": "months/data#test",
        "sites.target.layers": {
          "sweep": [
            12,
            20,
            28
          ]
        },
        "featurizers.rot.k": {
          "sweep": [
            8,
            32
          ]
        }
      }
    },
    "harvest": {
      "type": "intervention_protocol",
      "document": "../../demos/methods/protocols/mean_harvest.json",
      "set": {
        "model.key": "Qwen/Qwen3.6-35B-A3B",
        "model.dtype": "bf16",
        "data.base.dataset": "months/data#train",
        "sites.target.layers": 20
      }
    },
    "ablate": {
      "type": "intervention_protocol",
      "document": "../../demos/methods/protocols/mean_ablation.json",
      "set": {
        "model.key": "Qwen/Qwen3.6-35B-A3B",
        "model.dtype": "bf16",
        "data.base.dataset": "months/data#test",
        "data.counterfactual.dataset": "months/data#test",
        "sites.target.layers": 20
      }
    }
  }
}
