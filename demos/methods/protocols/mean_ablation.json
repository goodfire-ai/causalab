{
  "header": {
    "protocol_version": "4",
    "description": "Half two of mean replacement: swap the harvested corpus mean in as a `params` operand, on the test split. `entry: {slot: acts}` is how a consumer names a bundle the producer keyed by its READ's name rather than by the params convention 'value'. Zero replacement is the same document with `do: {swap: 0.0}` and no params - which is why the pair is worth shipping together: the difference between the two baselines is one line."
  },
  "model": {"key": "Qwen/Qwen2.5-7B", "revision": "main"},
  "data": {
    "base": {"dataset": "natural_domains_arithmetic/data/weekdays#test", "field": "input"},
    "counterfactual": {
      "dataset": "natural_domains_arithmetic/data/weekdays#test",
      "field": "counterfactual_inputs[0]"
    }
  },
  "method": {
    "intervened_models": {
      "ablated": {"input": "base", "reads": ["logits"], "writes": ["ablate"]}
    },
    "positions": {"tap": {"index": -1}},
    "sites": {
      "target": {"component": "block_output", "layers": [23]},
      "lm_head": {"component": "lm_head"}
    },
    "params": {
      "mu": {"file_path": "harvest/acts.safetensors", "entry": {"slot": "acts"}}
    },
    "reads": {"logits": {"site": "lm_head", "pos": -1}},
    "writes": {
      "ablate": {"site": "target", "pos": "tap", "do": {"swap": "mu"}}
    },
    "save": [
      {
        "read": "logits",
        "model": "ablated",
        "aggregation": {"kind": "logit_diff", "a": "base_answer", "b": "cf_answer"},
        "file_path": "ld.json"
      }
    ]
  }
}
