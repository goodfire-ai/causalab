{
  "header": {
    "protocol_version": "4",
    "description": "Several writes on ONE site at non-overlapping positions inside one intervened model - the multi-position patch. No other example shows it. Not a nicety: when an effect is spread over several positions, each position patched alone can read nothing, so a single-position scan cannot see the effect at all. Rule 8 is what makes this expressible: at most one absolute write per (site, OVERLAPPING pos, model), so three disjoint indices are three legal absolute writes rather than a conflict. Read the counterfactual once per position; the reads share the forward."
  },
  "model": {"key": "Qwen/Qwen2.5-7B", "revision": "main"},
  "data": {
    "base": {"dataset": "natural_domains_arithmetic/data/weekdays#train", "field": "input"},
    "counterfactual": {
      "dataset": "natural_domains_arithmetic/data/weekdays#train",
      "field": "counterfactual_inputs[0]"
    }
  },
  "method": {
    "intervened_models": {
      "original_counterfactual": {"input": "counterfactual", "reads": ["v_m4", "v_m3", "v_m2"]},
      "patched": {"input": "base", "reads": ["logits"], "writes": ["at_m4", "at_m3", "at_m2"]}
    },
    "sites": {
      "target": {"component": "block_output", "layers": [23]},
      "lm_head": {"component": "lm_head"}
    },
    "reads": {
      "v_m4": {"site": "target", "pos": -4},
      "v_m3": {"site": "target", "pos": -3},
      "v_m2": {"site": "target", "pos": -2},
      "logits": {"site": "lm_head", "pos": -1}
    },
    "writes": {
      "at_m4": {"site": "target", "pos": -4, "do": {"swap": "v_m4"}},
      "at_m3": {"site": "target", "pos": -3, "do": {"swap": "v_m3"}},
      "at_m2": {"site": "target", "pos": -2, "do": {"swap": "v_m2"}}
    },
    "save": [
      {
        "read": "logits",
        "model": "patched",
        "aggregation": {"kind": "logit_diff", "a": "cf_answer", "b": "base_answer"},
        "file_path": "iia.json"
      }
    ]
  }
}
