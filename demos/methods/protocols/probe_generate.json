{
  "header": {
    "protocol_version": "4",
    "description": "Exploration probe: greedy-decode 8 tokens under a residual-stream steer, then read the distribution at the last generated token. The continuation is addressed by an ordinary position (the `generated` frame), so it is a read, and an ordinary metric scores it — top_k with k=1 is the greedy continuation itself."
  },
  "model": {"key": "Qwen/Qwen2.5-7B", "revision": "main"},
  "data": {
    "base": {"dataset": "natural_domains_arithmetic/data/weekdays#train", "field": "input"}
  },
  "method": {
    "intervened_models": {
      "probed": {"input": "base", "reads": ["tail"], "writes": ["push"]}
    },
    "positions": {
      "last_new": {"generated": {"max_new_tokens": 8}, "index": -1}
    },
    "sites": {
      "target": {"component": "block_output", "layers": [23]},
      "lm_head": {"component": "lm_head"}
    },
    "reads": {"tail": {"site": "lm_head", "pos": "last_new"}},
    "writes": {
      "push": {
        "site": "target",
        "pos": -1,
        "do": {"add_scaled": {"op": 1.0, "alpha": 2.0}}
      }
    },
    "save": [
      {
        "read": "tail",
        "model": "probed",
        "aggregation": {"kind": "top_k", "k": 1, "by": "prob"},
        "file_path": "probe.json"
      }
    ]
  }
}
