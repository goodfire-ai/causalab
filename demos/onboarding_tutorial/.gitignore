# The per-example tables of the scan steps are regenerated by each tutorial's
# `causalab run` command (docs/demos.md §5.7); the rest of the run tree is kept.
artifacts/output/*/scan/*.json
artifacts/output/*/*_scan/*.json
# Each step's record is repeated field for field in the run's workflow.json,
# which is committed.
artifacts/output/**/_step.json
# Harvested activations and fitted featurizers are binary run products that no
# tutorial links; the same command writes them again.
artifacts/output/**/*.safetensors
