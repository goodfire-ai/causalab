{
  "header": {
    "protocol_version": "4",
    "description": "Reference for the DBM mask of arithmetic_neurons_fit.json: swap the 28 addition neurons of Feucht et al. 2026 (arXiv:2605.01148, Figure 8 and Section 5.1) of layer 18's MLP of Llama-3.1-8B from the counterfactual weekdays prompt at the last token, leave the other 14308 neurons at their base values, and save the held-out interchange intervention accuracy against the counterfactual's output day, which workflows/scripts/arithmetic_neurons/figures.py draws beside the mask."
  },
  "model": {"key": "meta-llama/Llama-3.1-8B", "revision": "main", "dtype": "bf16"},
  "data": {
    "base": {"dataset": "arithmetic_neurons/weekdays#test", "field": "input"},
    "counterfactual": {"dataset": "arithmetic_neurons/weekdays#test", "field": "counterfactual_inputs[0]"}
  },
  "method": {
    "intervened_models": {
      "original_counterfactual": {"input": "counterfactual", "reads": ["v_cf"]},
      "patched": {"input": "base", "reads": ["logits"], "writes": ["patch"]}
    },
    "sites": {
      "neurons": {"component": "mlp_neuron_output", "layers": [18]},
      "lm_head": {"component": "lm_head"}
    },
    "reads": {
      "v_cf": {"site": "neurons", "pos": -1, "dims": [1712, 10297, 8859, 8887, 3896, 12728, 2404, 13492, 8409, 3644, 2955, 251, 11029, 10099, 12154, 11545, 5700, 3650, 13003, 12778, 6339, 8343, 61, 1448, 1768, 2372, 6721, 11096]},
      "logits": {"site": "lm_head", "pos": -1}
    },
    "writes": {
      "patch": {"site": "neurons", "pos": -1, "dims": [1712, 10297, 8859, 8887, 3896, 12728, 2404, 13492, 8409, 3644, 2955, 251, 11029, 10099, 12154, 11545, 5700, 3650, 13003, 12778, 6339, 8343, 61, 1448, 1768, 2372, 6721, 11096], "do": {"swap": "v_cf"}}
    },
    "save": [
      {
        "read": "logits",
        "model": "patched",
        "aggregation": {"kind": "match", "expected": "label_forms"},
        "file_path": "iia.json"
      }
    ]
  }
}
