{
  "header": {
    "protocol_version": "4",
    "description": "Head-grouped desiderata-based masking (Davies et al. 2023, arXiv:2307.03637) at layer 22 of Qwen2.5-1.5B-Instruct: one gate parameter per attention head on attention_premix, the o-projection's head-major input, fitted on the 128 train pairs under an l1 term that charges for every kept head; figures.py draws rank.json and mcqa_components_dbm_head_apply.json scores the mask on the held-out pairs."
  },
  "model": {"key": "Qwen/Qwen2.5-1.5B-Instruct", "revision": "main", "dtype": "bf16"},
  "data": {
    "base": {"dataset": "mcqa_components_dbm/data#train", "field": "input"},
    "counterfactual": {
      "dataset": "mcqa_components_dbm/data#train",
      "field": "counterfactual_inputs[0]"
    }
  },
  "method": {
    "intervened_models": {
      "original_counterfactual": {"input": "counterfactual", "reads": ["v_cf"]},
      "masked": {"input": "base", "reads": ["logits"], "writes": ["mask"]}
    },
    "positions": {"slot": {"index": -1}},
    "sites": {
      "target": {"component": "attention_premix", "layers": [22]},
      "lm_head": {"component": "lm_head"}
    },
    "featurizers": {"gate": {"kind": "gate", "group": "head"}},
    "reads": {
      "v_cf": {"site": "target", "pos": "slot", "featurizer": "gate"},
      "logits": {"site": "lm_head", "pos": -1}
    },
    "writes": {
      "mask": {"site": "target", "pos": "slot", "featurizer": "gate", "do": {"swap": "v_cf"}}
    },
    "train": {
      "objective": {
        "ce": {
          "weight": 1.0,
          "read": "logits",
          "model": "masked",
          "aggregation": {"kind": "cross_entropy", "target": "label"}
        },
        "l1": {"weight": 0.01, "l1": "gate"}
      },
      "params": ["gate"],
      "optimizer": {"name": "adamw", "lr": 0.01, "weight_decay": 0.0},
      "steps": {"epochs": 20},
      "batch": {"pairs": 16},
      "anneal": {"gate.theta.temperature": [1.0, 0.01, 0.5]},
      "precision": {"feature": "fp32", "loss": "fp32"},
      "seed": 0
    },
    "save": [
      {"train": "ce", "file_path": "ce.json"},
      {"value": "gate", "site": "target", "file_path": "gate.safetensors"},
      {"kind": "rank", "file_path": "rank.json"}
    ]
  }
}
