{
  "header": {
    "protocol_version": "4",
    "description": "The component scan of the onboarding tutorial's page 09 (demos/onboarding_tutorial/09_components.md) on this package's 64 held-out pairs: swap the attention output, the MLP output or the whole residual stream of one layer at the answer slot with its value on the counterfactual prompt, and save whether the model then outputs the counterfactual letter, which figures.py draws as IIA over layer, one line per component."
  },
  "model": {"key": "Qwen/Qwen2.5-1.5B-Instruct", "revision": "main", "dtype": "bf16"},
  "data": {
    "base": {"dataset": "mcqa_components_dbm/data#test", "field": "input"},
    "counterfactual": {
      "dataset": "mcqa_components_dbm/data#test",
      "field": "counterfactual_inputs[0]"
    }
  },
  "method": {
    "intervened_models": {
      "original_counterfactual": {"input": "counterfactual", "reads": ["v_cf"]},
      "patched": {"input": "base", "reads": ["logits"], "writes": ["patch"]}
    },
    "positions": {"slot": {"index": -1}},
    "sites": {
      "target": {
        "component": {"sweep": ["attention_output", "mlp_output", "block_output"]},
        "layers": {"sweep": {"range": [0, 28]}}
      },
      "lm_head": {"component": "lm_head"}
    },
    "reads": {"v_cf": {"site": "target", "pos": "slot"}, "logits": {"site": "lm_head", "pos": -1}},
    "writes": {"patch": {"site": "target", "pos": "slot", "do": {"swap": "v_cf"}}},
    "save": [
      {
        "read": "logits",
        "model": "patched",
        "aggregation": {"kind": "match", "expected": "cf_answer"},
        "file_path": "iia.json"
      }
    ]
  }
}
