{
  "header": {
    "protocol_version": "4",
    "description": "Random-subspace control for the mcqa_symbol package: an untrained subspace featurizer is a random orthonormal basis drawn from its seed, so this document swaps three random k-dimensional subspaces at the answer slot of the selected layer on the test split and saves the interchange intervention accuracy against `label_forms`, the same score as the fits. The workflow runs it at k = 32, the DAS width, and at the rank the DBM-DAS fit learned; workflows/scripts/mcqa_symbol/iia_figure.py draws both beside the fits."
  },
  "model": {"key": "Qwen/Qwen2.5-1.5B-Instruct", "revision": "main", "dtype": "bf16"},
  "data": {
    "base": {"dataset": "mcqa_symbol/data#test", "field": "input"},
    "counterfactual": {"dataset": "mcqa_symbol/data#test", "field": "counterfactual_inputs[0]"}
  },
  "method": {
    "intervened_models": {
      "original_counterfactual": {"input": "counterfactual", "reads": ["v_cf"]},
      "patched": {"input": "base", "reads": ["logits"], "writes": ["patch"]}
    },
    "positions": {"answer_slot": {"index": -1}},
    "sites": {
      "target": {"component": "block_output", "layers": [27]},
      "lm_head": {"component": "lm_head"}
    },
    "featurizers": {
      "rot": {"kind": "subspace", "k": 32, "parametrization": "cayley", "seed": {"sweep": [0, 1, 2]}}
    },
    "reads": {
      "v_cf": {"site": "target", "pos": "answer_slot", "featurizer": "rot"},
      "logits": {"site": "lm_head", "pos": -1}
    },
    "writes": {
      "patch": {"site": "target", "pos": "answer_slot", "featurizer": "rot", "do": {"swap": "v_cf"}}
    },
    "save": [
      {
        "read": "logits",
        "model": "patched",
        "aggregation": {"kind": "match", "expected": "label_forms"},
        "file_path": "iia.json"
      }
    ]
  }
}
