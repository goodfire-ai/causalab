{
  "header": {
    "protocol_version": "4",
    "description": "DBM-DAS fit for the mcqa_symbol package: a 128-column rotation of the residual stream at the answer slot with a boundary gate behind it (Boundless DAS, Wu et al. 2023, arXiv:2305.08809), so the fit learns its own rank at the layer the workflow selects from the held-out DAS scores; ce pulls the boundary up and the l1 term (weight 1.0, the kept fraction) pulls it down, the boundary trains at ten times the rotation's rate and its temperature anneals 1.0 -> 0.1 over the whole fit, as demos/methods/protocols/das_boundless.json does. Every other setting is mcqa_symbol_das_fit.json. fit_diagnostics.json records the learned rank (hard_mask_size); mcqa_symbol_dbm_apply.json scores the fit on the test split."
  },
  "model": {"key": "Qwen/Qwen2.5-1.5B-Instruct", "revision": "main", "dtype": "bf16"},
  "data": {
    "base": {"dataset": "mcqa_symbol/data#train", "field": "input"},
    "counterfactual": {"dataset": "mcqa_symbol/data#train", "field": "counterfactual_inputs[0]"}
  },
  "method": {
    "intervened_models": {
      "original_counterfactual": {"input": "counterfactual", "reads": ["v_cf"]},
      "patched": {"input": "base", "reads": ["logits"], "writes": ["patch"]}
    },
    "positions": {"answer_slot": {"index": -1}},
    "sites": {
      "target": {"component": "block_output", "layers": [27]},
      "lm_head": {"component": "lm_head"}
    },
    "featurizers": {
      "rot": {"kind": "subspace", "k": 128, "parametrization": "cayley"},
      "bnd": {"kind": "gate", "parametrization": "boundary"}
    },
    "reads": {
      "v_cf": {"site": "target", "pos": "answer_slot", "featurizer": ["rot", "bnd"]},
      "logits": {"site": "lm_head", "pos": -1}
    },
    "writes": {
      "patch": {"site": "target", "pos": "answer_slot", "featurizer": ["rot", "bnd"], "do": {"swap": "v_cf"}}
    },
    "train": {
      "objective": {
        "ce": {
          "weight": 1.0,
          "read": "logits",
          "model": "patched",
          "aggregation": {"kind": "cross_entropy", "target": "label"}
        },
        "l1": {"weight": 1.0, "l1": "bnd"}
      },
      "params": ["rot", "bnd"],
      "optimizer": {"name": "adamw", "lr": {"rot": 0.001, "bnd": 0.01}, "weight_decay": 0.0},
      "steps": {"epochs": 20},
      "batch": {"pairs": 32},
      "anneal": {"bnd.theta.temperature": [1.0, 0.1, 1.0]},
      "precision": {"feature": "fp32", "loss": "fp32"},
      "seed": 0
    },
    "save": [
      {"value": "rot", "site": "target", "file_path": "rot.safetensors"},
      {"value": "bnd", "site": "target", "file_path": "bnd.safetensors"}
    ]
  }
}
