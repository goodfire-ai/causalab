      },
      "turn_on_16": {
        "site": "mlp_16",
        "pos": "all",
        "dims": [461, 3208, 4060],
        "do": {"swap": 3},
        "ragged": {"policy": "padded_masked"}
      },
      "turn_on_17": {
        "site": "mlp_17",
        "pos": "all",
