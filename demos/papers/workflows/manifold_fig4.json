      "type": "script",
      "script": {
        "module": "causalab.analysis.fit_pca"
      },
      "inputs": {
        "acts": {
          "step": "harvest_l28",
          "file": "acts.safetensors"
        },
        "k": 48
      },
      "outputs": {
        "weight": "basis.safetensors",
        "mean": "mean.safetensors",
        "spectrum": {
          "file": "spectrum.json",
          "columns": {
            "pc": "int64",
            "explained_variance": "float64",
            "explained_variance_ratio": "float64"
          }
        }
      }
    },
    "manifold_path": {
      "type": "script",
      "script": {
        "path": "scripts/manifold_fig4/manifold_path.py"
      },
      "inputs": {
        "acts": {
          "step": "harvest_l28",
          "file": "acts.safetensors"
        },
        "weight": {
          "step": "pca48",
          "file": "basis.safetensors"
        },
        "mean": {
          "step": "pca48",
          "file": "mean.safetensors"
        },
        "table": {
          "path": "../artifacts/data/manifold_fig4/data.json"
