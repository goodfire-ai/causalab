{
  "header": {
    "protocol_version": "4",
    "description": "Held-out interchange through the saved DAS subspace. Load the fitted artifact from the authored dependency and evaluate its intervention effectiveness without further fitting."
  },
  "model": {
    "key": "Qwen/Qwen3.6-35B-A3B",
    "revision": "995ad96eacd98c81ed38be0c5b274b04031597b0",
    "dtype": "bf16"
  },
  "data": {
    "base": {"dataset": "pairs#test", "field": "input"},
    "counterfactual": {"dataset": "pairs#test", "field": "counterfactual_inputs[0]"}
  },
  "method": {
    "intervened_models": {
      "original_counterfactual": {"input": "counterfactual", "reads": ["v_cf"]},
      "patched": {"input": "base", "reads": ["logits"], "writes": ["patch"]}
    },
    "sites": {
      "target": {"component": "block_output", "layers": [19]},
      "lm_head": {"component": "lm_head"}
    },
    "featurizers": {
      "rot": {
        "kind": "subspace",
        "k": 2,
        "parametrization": "cayley",
        "file_path": "das/rot.safetensors"
      }
    },
    "reads": {
      "v_cf": {"site": "target", "pos": -1, "featurizer": "rot"},
      "logits": {"site": "lm_head", "pos": -1}
    },
    "writes": {
      "patch": {"site": "target", "pos": -1, "featurizer": "rot", "do": {"swap": "v_cf"}}
    },
    "save": [
      {
        "read": "logits",
        "model": "patched",
        "aggregation": {"kind": "logit_diff", "a": "cf_answer", "b": "base_answer"},
        "file_path": "iia.json"
      },
      {
        "read": "logits",
        "model": "patched",
        "aggregation": {"kind": "cross_entropy", "target": "label"},
        "file_path": "ce.json"
      }
    ]
  }
}
