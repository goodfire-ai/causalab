{
  "header": {
    "protocol_version": "4",
    "description": "DBM swap through a coordinate gate with L1 regularization and temperature annealing. Anneal is a (start, end, fraction) list, not a sweep axis. Evaluation uses a hard mask; inspect gate confidence and held-out intervention effectiveness separately. These small-data fitting settings are examples, not validated research hyperparameters."
  },
  "model": {
    "key": "Qwen/Qwen3.6-35B-A3B",
    "revision": "995ad96eacd98c81ed38be0c5b274b04031597b0",
    "dtype": "bf16"
  },
  "data": {
    "base": {"dataset": "pairs#train", "field": "input"},
    "counterfactual": {"dataset": "pairs#train", "field": "counterfactual_inputs[0]"}
  },
  "method": {
    "intervened_models": {
      "original_counterfactual": {"input": "counterfactual", "reads": ["v_cf"]},
      "masked": {"input": "base", "reads": ["logits"], "writes": ["mask"]}
    },
    "sites": {
      "target": {"component": "block_output", "layers": [19]},
      "lm_head": {"component": "lm_head"}
    },
    "featurizers": {"gate": {"kind": "gate"}},
    "reads": {
      "v_cf": {"site": "target", "pos": -1, "featurizer": "gate"},
      "logits": {"site": "lm_head", "pos": -1}
    },
    "writes": {
      "mask": {"site": "target", "pos": -1, "featurizer": "gate", "do": {"swap": "v_cf"}}
    },
    "train": {
      "objective": {
        "ce": {
          "weight": 1.0,
          "read": "logits",
          "model": "masked",
          "aggregation": {"kind": "cross_entropy", "target": "label"}
        },
        "l1": {"weight": 0.01, "l1": "gate"}
      },
      "params": ["gate"],
      "optimizer": {"name": "adamw", "lr": 0.001, "weight_decay": 0.0},
      "steps": {"updates": 2},
      "batch": {"pairs": 2},
      "anneal": {"gate.theta.temperature": [1.0, 0.01, 0.5]},
      "precision": {"feature": "fp32", "loss": "fp32"},
      "eval": {
        "every": {"epochs": 1},
        "aggregations": {
          "iia": {
            "read": "logits",
            "model": "masked",
            "aggregation": {"kind": "logit_diff", "a": "cf_answer", "b": "base_answer"}
          }
        },
        "split": "pairs#test"
      },
      "seed": 0
    },
    "save": [
      {"train": "iia", "file_path": "iia.json"},
      {"train": "ce", "file_path": "ce.json"},
      {"value": "gate", "site": "target", "file_path": "gate.safetensors"}
    ]
  }
}
