{
  "header": {
    "protocol_version": "4",
    "description": "Interchange intervention: swap the answer-slot residual from the counterfactual into base; IIA scoring."
  },
  "model": {
    "key": "Qwen/Qwen3.6-35B-A3B",
    "revision": "995ad96eacd98c81ed38be0c5b274b04031597b0",
    "dtype": "bf16"
  },
  "data": {"base": {"dataset": "pairs#test", "field": "input"}},
  "method": {
    "intervened_models": {
      "original": {"input": "base", "reads": ["v_cf"]},
      "patched": {"input": "base", "reads": ["logits"], "writes": ["patch"]}
    },
    "sites": {
      "target": {"component": "block_output", "layers": [19]},
      "lm_head": {"component": "lm_head"}
    },
    "reads": {"v_cf": {"site": "target", "pos": -1}, "logits": {"site": "lm_head", "pos": -1}},
    "writes": {
      "patch": {"site": "target", "pos": -1, "do": {"swap": "v_cf"}}
    },
    "save": [
      {"read": "logits", "model": "patched", "file_path": "logits.safetensors"},
      {
        "read": "logits",
        "model": "patched",
        "aggregation": {"kind": "match", "expected": "base_answer"},
        "file_path": "accuracy.json"
      }
    ]
  }
}
