{
  "header": {
    "protocol_version": "4",
    "description": "Layer-band attention patching as ONE document. A band patches the complete attention_output at every layer in the span during the SAME forward pass, and the sweep language genuinely cannot express that - one start-layer value would have to expand into four or eight dependent writes, and a sweep expands one axis into independent points. 'intervened_models' is the mechanism that can: each entry names the set of writes in force for one forward, so several bands - overlapping ones included - are several entries over ONE table of per-layer writes. That is one model load for every band, not one per band; a verified A3B document carried 41 sites, 40 writes and 67 intervened_models (every 5- and 10-layer band of a 40-layer tower) in a single campaign. Scale this by extending the sites/reads/writes tables one entry per layer and adding one intervened_models entry per band; nothing else changes. Note the two widths here share their writes: band8_L9 is band4_L9's and band4_L13's writes together, and each write is authored once."
  },
  "model": {"key": "Qwen/Qwen2.5-7B", "revision": "main", "dtype": "bf16"},
  "data": {
    "base": {"dataset": "natural_domains_arithmetic/data/weekdays#train", "field": "input"},
    "counterfactual": {
      "dataset": "natural_domains_arithmetic/data/weekdays#train",
      "field": "counterfactual_inputs[0]"
    }
  },
  "method": {
    "intervened_models": {
      "original_counterfactual": {
        "input": "counterfactual",
        "reads": ["v_a9", "v_a10", "v_a11", "v_a12", "v_a13", "v_a14", "v_a15", "v_a16"]
      },
      "band4_L9": {
        "input": "base",
        "reads": ["logits_band4_L9"],
        "writes": ["w9", "w10", "w11", "w12"]
      },
      "band4_L13": {
        "input": "base",
        "reads": ["logits_band4_L13"],
        "writes": ["w13", "w14", "w15", "w16"]
      },
      "band8_L9": {
        "input": "base",
        "reads": ["logits_band8_L9"],
        "writes": ["w9", "w10", "w11", "w12", "w13", "w14", "w15", "w16"]
      }
    },
    "positions": {"tap": {"index": -1}},
    "sites": {
      "a9": {"component": "attention_output", "layers": [9]},
      "a10": {"component": "attention_output", "layers": [10]},
      "a11": {"component": "attention_output", "layers": [11]},
      "a12": {"component": "attention_output", "layers": [12]},
      "a13": {"component": "attention_output", "layers": [13]},
      "a14": {"component": "attention_output", "layers": [14]},
      "a15": {"component": "attention_output", "layers": [15]},
      "a16": {"component": "attention_output", "layers": [16]},
      "lm_head": {"component": "lm_head"}
    },
    "reads": {
      "v_a9": {"site": "a9", "pos": "tap"},
      "v_a10": {"site": "a10", "pos": "tap"},
      "v_a11": {"site": "a11", "pos": "tap"},
      "v_a12": {"site": "a12", "pos": "tap"},
      "v_a13": {"site": "a13", "pos": "tap"},
      "v_a14": {"site": "a14", "pos": "tap"},
      "v_a15": {"site": "a15", "pos": "tap"},
      "v_a16": {"site": "a16", "pos": "tap"},
      "logits_band4_L9": {"site": "lm_head", "pos": -1},
      "logits_band4_L13": {"site": "lm_head", "pos": -1},
      "logits_band8_L9": {"site": "lm_head", "pos": -1}
    },
    "writes": {
      "w9": {"site": "a9", "pos": "tap", "do": {"swap": "v_a9"}},
      "w10": {"site": "a10", "pos": "tap", "do": {"swap": "v_a10"}},
      "w11": {"site": "a11", "pos": "tap", "do": {"swap": "v_a11"}},
      "w12": {"site": "a12", "pos": "tap", "do": {"swap": "v_a12"}},
      "w13": {"site": "a13", "pos": "tap", "do": {"swap": "v_a13"}},
      "w14": {"site": "a14", "pos": "tap", "do": {"swap": "v_a14"}},
      "w15": {"site": "a15", "pos": "tap", "do": {"swap": "v_a15"}},
      "w16": {"site": "a16", "pos": "tap", "do": {"swap": "v_a16"}}
    },
    "save": [
      {
        "read": "logits_band4_L9",
        "model": "band4_L9",
        "aggregation": {"kind": "logit_diff", "a": "cf_answer", "b": "base_answer"},
        "file_path": "iia_band4_L9.json"
      },
      {
        "read": "logits_band4_L13",
        "model": "band4_L13",
        "aggregation": {"kind": "logit_diff", "a": "cf_answer", "b": "base_answer"},
        "file_path": "iia_band4_L13.json"
      },
      {
        "read": "logits_band8_L9",
        "model": "band8_L9",
        "aggregation": {"kind": "logit_diff", "a": "cf_answer", "b": "base_answer"},
        "file_path": "iia_band8_L9.json"
      }
    ]
  }
}
