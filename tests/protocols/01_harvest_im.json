{
  "header": {
    "protocol_version": "4",
    "description": "Activation harvesting: pure reads at two layers x two positions, one un-intervened forward. No writes, hence no intervened_models section."
  },
  "model": {"key": "Qwen/Qwen3-8B", "revision": "main"},
  "data": {"base": {"dataset": "weekdays/data#train", "field": "input"}},
  "method": {
    "intervened_models": {
      "original": {
        "input": "base",
        "reads": ["acts_L8_ans", "acts_L8_ent", "acts_L24_ans", "acts_L24_ent"]
      }
    },
    "positions": {"answer_tok": {"index": -1}, "entity": {"variable": "entity"}},
    "sites": {
      "L8": {"component": "block_output", "layers": [8]},
      "L24": {"component": "block_output", "layers": [24]}
    },
    "reads": {
      "acts_L8_ans": {"site": "L8", "pos": "answer_tok"},
      "acts_L8_ent": {"site": "L8", "pos": "entity"},
      "acts_L24_ans": {"site": "L24", "pos": "answer_tok"},
      "acts_L24_ent": {"site": "L24", "pos": "entity"}
    },
    "save": [
      {
        "read": "acts_L8_ans",
        "model": "original",
        "file_path": "acts_L8_ans.safetensors"
      },
      {
        "read": "acts_L8_ent",
        "model": "original",
        "file_path": "acts_L8_ent.safetensors"
      },
      {
        "read": "acts_L24_ans",
        "model": "original",
        "file_path": "acts_L24_ans.safetensors"
      },
      {
        "read": "acts_L24_ent",
        "model": "original",
        "file_path": "acts_L24_ent.safetensors"
      }
    ]
  }
}
