{
  "header": {
    "protocol_version": "4",
    "description": "DBM: a plain swap through a gate featurizer computes sigma(theta)*x_src + (1-sigma(theta))*x_base; theta trained under L1 with a temperature anneal. Gate width derived from (model, site); note anneal's value IS a list (start, end, frac) - list-typed fields are never sweep axes. WARNING: Gate._mask is a HARD theta>0 mask in eval mode, so a theta that never separated makes the mask a coin flip on gradient noise; about half the dimensions swap, and at a readout layer that can still give a high score. Read fit_diagnostics.json before believing a DBM number: decisive_fraction near 0 means the gate never committed and the score describes noise. The l1 and anneal values here are not tuned so that theta separates."
  },
  "model": {"key": "Qwen/Qwen3-8B", "revision": "main", "dtype": "bf16"},
  "data": {
    "base": {"dataset": "weekdays/data#train", "field": "input"},
    "counterfactual": {"dataset": "weekdays/data#train", "field": "counterfactual_inputs[0]"}
  },
  "method": {
    "intervened_models": {
      "original_counterfactual": {"input": "counterfactual", "reads": ["v_cf"]},
      "masked": {"input": "base", "reads": ["logits"], "writes": ["mask"]}
    },
    "sites": {
      "target": {"component": "block_output", "layers": [18]},
      "lm_head": {"component": "lm_head"}
    },
    "featurizers": {"gate": {"kind": "gate"}},
    "reads": {
      "v_cf": {"site": "target", "pos": -1, "featurizer": "gate"},
      "logits": {"site": "lm_head", "pos": -1}
    },
    "writes": {
      "mask": {"site": "target", "pos": -1, "featurizer": "gate", "do": {"swap": "v_cf"}}
    },
    "train": {
      "objective": {
        "ce": {
          "weight": 1.0,
          "read": "logits",
          "model": "masked",
          "aggregation": {"kind": "cross_entropy", "target": "label"}
        },
        "l1": {"weight": 0.01, "l1": "gate"}
      },
      "params": ["gate"],
      "optimizer": {"name": "adamw", "lr": 0.001, "weight_decay": 0.0},
      "steps": {"epochs": 20},
      "batch": {"pairs": 16},
      "anneal": {"gate.theta.temperature": [1.0, 0.01, 0.5]},
      "precision": {"feature": "fp32", "loss": "fp32"},
      "eval": {
        "every": {"epochs": 1},
        "split": "weekdays/data#test",
        "aggregations": {
          "iia": {
            "read": "logits",
            "model": "masked",
            "aggregation": {"kind": "logit_diff", "a": "cf_answer", "b": "base_answer"}
          }
        }
      },
      "early_stop": {"on": "iia", "patience": 3, "mode": "max"},
      "seed": 0
    },
    "save": [
      {"train": "iia", "file_path": "iia.json"},
      {"train": "ce", "file_path": "ce.json"},
      {"value": "gate", "site": "target", "file_path": "gate.safetensors"}
    ]
  }
}
