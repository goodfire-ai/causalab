{
  "header": {
    "protocol_version": "4",
    "description": "The Hydra effect (McGrath et al. 2023, arXiv:2307.15771), main experiment: resample-ablate attention layer 13 at the final token, measure downstream layers' direct effects (contribution injected as the final residual, read at lm_head) in both the clean and ablated intervened models. Two probe layers written out; a range axis on a single probe site would fan the whole pattern to the paper's grid."
  },
  "model": {"key": "Qwen/Qwen3-8B", "revision": "main"},
  "data": {
    "base": {"dataset": "pile/sample", "field": "input"},
    "counterfactual": {"dataset": "pile/sample", "field": "resample_input"}
  },
  "method": {
    "intervened_models": {
      "original_counterfactual": {"input": "counterfactual", "reads": ["v_noise"]},
      "original_base": {"input": "base", "reads": ["logits_clean", "a14_clean", "a20_clean"]},
      "ablated": {
        "input": "base",
        "reads": ["logits_abl", "a14_abl", "a20_abl"],
        "writes": ["resample"]
      },
      "with_inj14_clean": {"input": "base", "reads": ["de14_clean"], "writes": ["inj14_clean"]},
      "with_inj20_clean": {"input": "base", "reads": ["de20_clean"], "writes": ["inj20_clean"]},
      "with_inj14_abl": {"input": "base", "reads": ["de14_abl"], "writes": ["inj14_abl"]},
      "with_inj20_abl": {"input": "base", "reads": ["de20_abl"], "writes": ["inj20_abl"]}
    },
    "sites": {
      "abl": {"component": "attention_output", "layers": [13]},
      "probe14": {"component": "attention_output", "layers": [14]},
      "probe20": {"component": "attention_output", "layers": [20]},
      "resid_final": {"component": "block_output", "layers": [31]},
      "lm_head": {"component": "lm_head"}
    },
    "reads": {
      "v_noise": {"site": "abl", "pos": -1},
      "logits_clean": {"site": "lm_head", "pos": -1},
      "logits_abl": {"site": "lm_head", "pos": -1},
      "a14_clean": {"site": "probe14", "pos": -1},
      "a20_clean": {"site": "probe20", "pos": -1},
      "a14_abl": {"site": "probe14", "pos": -1},
      "a20_abl": {"site": "probe20", "pos": -1},
      "de14_clean": {"site": "lm_head", "pos": -1},
      "de20_clean": {"site": "lm_head", "pos": -1},
      "de14_abl": {"site": "lm_head", "pos": -1},
      "de20_abl": {"site": "lm_head", "pos": -1}
    },
    "writes": {
      "resample": {"site": "abl", "pos": -1, "do": {"swap": "v_noise"}},
      "inj14_clean": {"site": "resid_final", "pos": -1, "do": {"swap": "a14_clean"}},
      "inj20_clean": {"site": "resid_final", "pos": -1, "do": {"swap": "a20_clean"}},
      "inj14_abl": {"site": "resid_final", "pos": -1, "do": {"swap": "a14_abl"}},
      "inj20_abl": {"site": "resid_final", "pos": -1, "do": {"swap": "a20_abl"}}
    },
    "save": [
      {
        "read": "logits_clean",
        "model": "original_base",
        "aggregation": {"kind": "token_logit", "token": "ml_token"},
        "file_path": "te_clean.json"
      },
      {
        "read": "logits_abl",
        "model": "ablated",
        "aggregation": {"kind": "token_logit", "token": "ml_token"},
        "file_path": "te_abl.json"
      },
      {
        "read": "de14_clean",
        "model": "with_inj14_clean",
        "aggregation": {"kind": "token_logit", "token": "ml_token"},
        "file_path": "de14_clean.json"
      },
      {
        "read": "de20_clean",
        "model": "with_inj20_clean",
        "aggregation": {"kind": "token_logit", "token": "ml_token"},
        "file_path": "de20_clean.json"
      },
      {
        "read": "de14_abl",
        "model": "with_inj14_abl",
        "aggregation": {"kind": "token_logit", "token": "ml_token"},
        "file_path": "de14_abl.json"
      },
      {
        "read": "de20_abl",
        "model": "with_inj20_abl",
        "aggregation": {"kind": "token_logit", "token": "ml_token"},
        "file_path": "de20_abl.json"
      }
    ]
  }
}
