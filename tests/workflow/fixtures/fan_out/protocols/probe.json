{
  "header": {
    "protocol_version": "4",
    "description": "The fanned-out behavioral fixture (workflow spec §2.9): tests/workflow/fixtures/behavioral/protocols/qa_probe.json's shape on gpt2 with two axes a per-child conditional can be declared over — a swept site `probe` (sites.probe.layers, read at the continuation and reduced by a top_k metric, the per_target axis) and a swept answer position (positions.said_answer, two decode budgets, the per_variable axis) — four points. The stub engine in tests/workflow/test_fan_out.py writes continuations whose text says the answer at layer 0 and not at layer 1, so the two children of a sites.probe.layers fan-out decide pass and fail."
  },
  "model": {"key": "gpt2", "revision": "main", "dtype": "fp32"},
  "data": {"base": {"dataset": "qa/data#development", "field": "input"}},
  "method": {
    "intervened_models": {
      "original": {"input": "base", "reads": ["steps", "where", "h"]}
    },
    "positions": {
      "continuation": {"generated": {"max_new_tokens": 4}, "all": true},
      "said_answer": {
        "sweep": [
          {"generated": {"max_new_tokens": 4}, "variable": "result"},
          {"generated": {"max_new_tokens": 5}, "variable": "result"}
        ]
      }
    },
    "sites": {
      "lm_head": {"component": "lm_head"},
      "probe": {
        "component": "block_output",
        "layers": {"sweep": [0, 1]}
      }
    },
    "reads": {
      "steps": {"site": "lm_head", "pos": "continuation"},
      "where": {"site": "lm_head", "pos": "said_answer"},
      "h": {"site": "probe", "pos": "continuation"}
    },
    "save": [
      {
        "read": "steps",
        "model": "original",
        "aggregation": {"kind": "top_k", "k": 1, "by": "prob"},
        "file_path": "per_step.json"
      },
      {
        "read": "steps",
        "model": "original",
        "aggregation": {"kind": "decode"},
        "file_path": "said.json"
      },
      {
        "read": "where",
        "model": "original",
        "aggregation": {"kind": "decode"},
        "file_path": "said_at.json"
      },
      {
        "read": "h",
        "model": "original",
        "aggregation": {"kind": "top_k", "k": 1, "by": "value"},
        "file_path": "h_top.json"
      }
    ]
  }
}
